import { error, fail, redirect } from '@sveltejs/kit';
import { api } from '#lib/api/client.js';[% if data.Auth %]
import { requireUser } from '#lib/server/auth.js';[% endif %]
import { [% if data.Toggle %]fromItem, [% endif %]problemMessage[% if data.Toggle %], toBody[% endif %] } from './schema';
import type { Actions, PageServerLoad } from './$types';

/** The number of [[ data.PluralWords ]] on one page of the list. */
const perPage = 20;

// pageNumber reads ?page=. A missing or invalid value is the first page.
function pageNumber(value: FormDataEntryValue | null): number {
	const n = Number(value);
	return Number.isSafeInteger(n) && n > 0 ? n : 1;
}

// id reads a [[ data.Words ]] id. It returns 0 when the value is not a positive whole number.
function id(value: FormDataEntryValue | null): number {
	const n = Number(value);
	return Number.isSafeInteger(n) && n > 0 ? n : 0;
}

export const load: PageServerLoad = async ({ fetch, [% if data.Auth %]locals, [% endif %]url }) => {[% if data.Auth %]
	requireUser(locals, url);[% endif %]
	const page = pageNumber(url.searchParams.get('page'));
	const { data, error: problem, response } = await api.GET('[[ data.APIPath ]]', {
		fetch,
		baseUrl: __PUBLIC_ORIGIN__,
		params: { query: { limit: perPage, offset: (page - 1) * perPage } }
	});
	if (!data) error(response.status, problemMessage(problem, response.status));
	const pages = Math.max(1, Math.ceil(data.total / perPage));
	if (page > pages) {
		// The page is past the end, for example after a delete: show the last page.
		const last = new URL(url);
		last.searchParams.set('page', String(pages));
		redirect(303, last.pathname + last.search);
	}
	return { items: data.items, total: data.total, page, perPage };
};

export const actions: Actions = {[% if data.Toggle %]
	// toggle sets [[ data.Toggle.Col ]] of one [[ data.Words ]]. PUT replaces the whole [[ data.Words ]], so it sends every field.
	toggle: async ({ request, fetch[% if data.Auth %], locals, url[% endif %] }) => {[% if data.Auth %]
		requireUser(locals, url);[% endif %]
		const form = await request.formData();
		const path = { id: id(form.get('id')) };
		if (path.id === 0) return fail(400, { message: 'The request has no [[ data.Words ]] id.' });
		const { data: item, error: problem, response } = await api.GET('[[ data.APIPath ]]/{id}', {
			fetch,
			baseUrl: __PUBLIC_ORIGIN__,
			params: { path }
		});
		if (!item) return fail(response.status, { message: problemMessage(problem, response.status) });
		const saved = await api.PUT('[[ data.APIPath ]]/{id}', {
			fetch,
			baseUrl: __PUBLIC_ORIGIN__,
			params: { path },
			body: { ...toBody(fromItem(item)[% if data.Time %], item[% endif %]), [[ data.Toggle.Col ]]: form.get('value') === 'true' }
		});
		if (!saved.data) {
			return fail(saved.response.status, { message: problemMessage(saved.error, saved.response.status) });
		}
		return { saved: path.id };
	},[% endif %]
	delete: async ({ request, fetch[% if data.Auth %], locals[% endif %], url }) => {[% if data.Auth %]
		requireUser(locals, url);[% endif %]
		const form = await request.formData();
		const path = { id: id(form.get('id')) };
		if (path.id === 0) return fail(400, { message: 'The request has no [[ data.Words ]] id.' });
		const { error: problem, response } = await api.DELETE('[[ data.APIPath ]]/{id}', {
			fetch,
			baseUrl: __PUBLIC_ORIGIN__,
			params: { path }
		});
		// A [[ data.Words ]] that is already gone is not an error.
		if (!response.ok && response.status !== 404) {
			return fail(response.status, { message: problemMessage(problem, response.status) });
		}
		const page = pageNumber(url.searchParams.get('page'));
		redirect(303, page > 1 ? `[[ data.Route ]]?page=${page}&deleted=1` : '[[ data.Route ]]?deleted=1');
	}
};
