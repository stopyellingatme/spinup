# Rust twin of testdata/script/upgrade_flow.txtar (Go blob eb098bcef4340b4450b5095864bd595da24ba051).
# The plan leaves the main checkout clean.
# The kit is not published yet, so the pin-only dependency step resolves it locally.
env SPINUP_KIT_REPLACE=$SPINUP_KIT_DIR
mkversion 0.0.1 overlay
env SPINUP_TEMPLATES_DIR=$WORK/templates
exec spinup new demo --api-only --module example.com/demo --non-interactive
cd demo
exec git status --porcelain
! stdout .
exec spinup upgrade --plan
stdout 'Upgrade 0.0.0-dev -> 0.0.1'
stdout 'upgrade-added.txt'
stdout 'deploy/compose.dev.yml'
exists .spinup/plan.json
grep '"to": "0.0.1"' .spinup/plan.json
! grep '"Data"' .spinup/plan.json
exec git status --porcelain
! stdout .

# Competing edits stop only the upgrade worktree.
exec sed 's/The application routes./My application routes./' api/src/routes.rs
cp stdout api/src/routes.rs
cp api/src/routes.rs $WORK/resolved-routes.rs
exec git add api/src/routes.rs
exec git commit -m 'Edit route comment'
exec sh -c 'spinup upgrade --yes --no-verify; test $? -eq 3'
stderr 'api/src/routes.rs'
grep '^<<<<<<<' .spinup/upgrade/0.0.1/api/src/routes.rs
exists .spinup/upgrade.json
exec git status --porcelain
! stdout .
grep 'My application' api/src/routes.rs
! exec spinup upgrade --yes --no-verify
stderr '--continue'
exec sh -c 'spinup upgrade --continue; test $? -eq 3'
stderr 'api/src/routes.rs'
cp $WORK/resolved-routes.rs .spinup/upgrade/0.0.1/api/src/routes.rs
exec spinup upgrade --continue --yes --no-verify
! stdout 'go fix'
stdout 'git merge spinup/upgrade-0.0.1'
# The cargo phases (ADR 0021 §8): the kit patch stays, and pins at the stack need no update.
! stdout '^Dependency '
grep '^spinup-kit = \{ path = "'$SPINUP_KIT_DIR'" \}$' .spinup/upgrade/0.0.1/api/Cargo.toml
cmp api/Cargo.toml .spinup/upgrade/0.0.1/api/Cargo.toml
cmp api/Cargo.lock .spinup/upgrade/0.0.1/api/Cargo.lock
! exists .spinup/upgrade.json
grep '"template_version": "0.0.1"' .spinup/upgrade/0.0.1/spinup.lock
exec git log spinup/upgrade-0.0.1 --format=%s
stdout 'spinup upgrade 0.0.0-dev -> 0.0.1'
stdout 'spinup upgrade: lock 0.0.1'
exists .spinup/upgrade/0.0.1/upgrade-added.txt
grep '^# Updated development compose file.' .spinup/upgrade/0.0.1/deploy/compose.dev.yml
! grep '^# Updated development compose file.' deploy/compose.dev.yml
exec git status --porcelain
! stdout .

# An app without user edits upgrades without conflicts.
cd $WORK
exec spinup new clean --api-only --module example.com/clean --non-interactive
cd clean
exec spinup upgrade --yes --no-verify
stdout 'git merge spinup/upgrade-0.0.1'
! exists .spinup/upgrade.json
exists .spinup/upgrade/0.0.1/upgrade-added.txt
cmp api/Cargo.toml .spinup/upgrade/0.0.1/api/Cargo.toml
cmp api/Cargo.lock .spinup/upgrade/0.0.1/api/Cargo.lock
grep '^# Updated development compose file.' .spinup/upgrade/0.0.1/deploy/compose.dev.yml
! grep '^# Updated development compose file.' deploy/compose.dev.yml
exec git status --porcelain
! stdout .

# Abort removes both the upgrade worktree and its branch.
cd $WORK
exec spinup new aborted --api-only --module example.com/aborted --non-interactive
cd aborted
cp $WORK/resolved-routes.rs api/src/routes.rs
exec git add api/src/routes.rs
exec git commit -m 'Edit route comment'
exec sh -c 'spinup upgrade --yes --no-verify; test $? -eq 3'
stderr 'api/src/routes.rs'
! exec spinup upgrade --abort
stderr '--yes'
exec spinup upgrade --abort --yes
! exists .spinup/upgrade/0.0.1
! exists .spinup/upgrade.json
exec git branch --list spinup/upgrade-0.0.1
! stdout .
exec git status --porcelain
! stdout .

# Abort also recovers when the worktree directory was removed.
exec sh -c 'spinup upgrade --yes --no-verify; test $? -eq 3'
rm .spinup/upgrade/0.0.1
exec spinup upgrade --abort --yes
! exists .spinup/upgrade.json
exec git branch --list spinup/upgrade-0.0.1
! stdout .
exec git worktree list --porcelain
! stdout 'spinup/upgrade-0.0.1'

# Committed conflicts require a warning before the merge instruction.
exec spinup upgrade --yes --no-verify --commit-conflicts
stdout 'Warning: committed conflict markers in: api/src/routes.rs'
stdout 'Resolve these files before running git merge'
! stdout 'Next: git merge'
! exists .spinup/upgrade.json
exec git show spinup/upgrade-0.0.1:api/src/routes.rs
stdout '<<<<<<<'

-- overlay/packs/api/files/api/src/routes.rs --
//! The upgraded application routes.

use axum::Router;
use kit::db::PgPool;

/// Registers the application routes.
pub fn routes() -> Router<PgPool> {
    // Add application routes here. Generators never edit this file.
    Router::new()
}

-- overlay/packs/api/files/deploy/compose.dev.yml.tmpl --
# Updated development compose file.
name: [[ data.app_name ]]-dev

services:
  postgres:
    image: [% if (data.db_version == "18") %][[ image("postgres") ]][% else %][% if (data.db_version == "17") %][[ image("postgres-17") ]][% else %][[ image("postgres-16") ]][% endif %][% endif %]
    environment:
      POSTGRES_USER: app
      POSTGRES_DB: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-app}
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql[% if (data.db_version != "18") %]/data[% endif %]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 5s
      timeout: 5s
      retries: 10
  mailpit:
    image: [[ image("mailpit") ]]
    ports:
      - "127.0.0.1:8025:8025"
      - "127.0.0.1:1025:1025"

volumes:
  postgres_data:

-- overlay/packs/base/files/upgrade-added.txt --
Added by upgrade.

-- overlay/packs/base/pack.d/upgrade.toml --
[[files]]
path = "upgrade-added.txt"
source = "files/upgrade-added.txt"
class = "managed"
