Extension area.
-- version2 --
name = "example"
version = "2.0.0"
api = 1
spinup = ">=0.0.0"
description = "Example version two."

[[generators]]
name = "greeting"
short = "Create a greeting"
args = ["Name"]

[[generators.files]]
path = "greetings/{{.Name}}.txt"
source = "files/greeting.txt.tmpl"
class = "scaffold"
