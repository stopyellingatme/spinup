[!exec:sops] skip 'sops is required'
[!exec:age-keygen] skip 'age-keygen is required'

env SPINUP_KEYS_DIR=$WORK/keys
env SPINUP_KIT_REPLACE=$SPINUP_REPO/kit
exec spinup new app --api-only --module example.com/app --modules ci,secrets --non-interactive
cd app

# Read the recovery recipient without storing private material in the project.
exec age-keygen -o $WORK/recovery.agekey
exec sh -c 'age-keygen -y "$WORK/recovery.agekey" > "$WORK/recipient"'
exec age-keygen -o $WORK/ci.agekey
exec sh -c 'age-keygen -y "$WORK/ci.agekey" > "$WORK/ci-recipient"'
exec sh -c 'spinup secrets init --env staging --recovery-recipient "$(cat "$WORK/recipient")" --ci-recipient "$(cat "$WORK/ci-recipient")"'
exists $WORK/keys/app-staging.agekey
exists secrets/staging.enc.yaml
! grep 'AGE-SECRET-KEY' .sops.yaml
exec sh -c 'printf value | spinup secrets set --env staging DATABASE_URL'
exec spinup secrets get --env staging DATABASE_URL
stdout '^value$'
! grep 'value' secrets/staging.enc.yaml
exec spinup secrets diff --env staging
stdout 'added DATABASE_URL'
! stdout 'value'

# The recovery key can independently decrypt the ciphertext.
exec sh -c 'SOPS_AGE_KEY_FILE="$WORK/recovery.agekey" SOPS_AGE_KEY= sops decrypt --output-type json secrets/staging.enc.yaml'
stdout '"DATABASE_URL": "value"'
exec sh -c 'SOPS_AGE_KEY_FILE="$WORK/ci.agekey" SOPS_AGE_KEY= sops decrypt --output-type json secrets/staging.enc.yaml'
stdout '"DATABASE_URL": "value"'

# A different environment key cannot decrypt staging secrets.
exec sh -c 'spinup secrets init --env production --recovery-recipient "$(cat "$WORK/recipient")"'
! exec sh -c 'SOPS_AGE_KEY_FILE="$SPINUP_KEYS_DIR/app-production.agekey" SOPS_AGE_KEY= sops decrypt secrets/staging.enc.yaml'

# Commit an encrypted baseline and compare a changed entry.
exec git add .sops.yaml secrets/staging.enc.yaml
exec git commit -m 'encrypted staging secrets'
exec sh -c 'printf changed | spinup secrets set --env staging DATABASE_URL'
exec spinup secrets diff --env staging
stdout '^changed DATABASE_URL$'
exec spinup secrets rotate --env staging
exec spinup secrets rekey --env staging
exec spinup secrets get --env staging DATABASE_URL
stdout '^changed$'

# Tracked plaintext secrets make the full doctor check fail.
cp ../plain.yaml secrets/plain.yaml
exec git add secrets/plain.yaml
! exec spinup doctor
stdout 'fail\s+plaintext-secrets'
stdout 'secrets/plain.yaml'
stdout 'Try:'

-- plain.yaml --
PASSWORD: unsafe
