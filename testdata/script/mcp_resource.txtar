# Resource tools call the generated strict methods and build offline.
env SPINUP_KIT_REPLACE=$SPINUP_REPO/kit
exec spinup new demo --modules auth,apikeys,mcp --module example.com/demo --no-git --non-interactive
cd demo
exec spinup g resource Note body:text --mcp --api-only
exists api/internal/mcp/notes_tools.go
grep '// spinup:mcp-tool registerNotesTools' api/internal/mcp/notes_tools.go
grep 'registerNotesTools\(s, d\)' api/internal/mcp/tools_gen.go
grep 'Name: "list_notes"' api/internal/mcp/notes_tools.go
grep 'Name: "delete_note"' api/internal/mcp/notes_tools.go
# A second resource preserves the first registration.
exec spinup g resource Task title:string --mcp --api-only --role manager
grep 'registerNotesTools\(s, d\)' api/internal/mcp/tools_gen.go
grep 'registerTasksTools\(s, d\)' api/internal/mcp/tools_gen.go
exec cp $WORK/mcp_test.go api/internal/mcp/generated_test.go
cd api
exec go build ./...
exec go test -race ./internal/mcp
cd $WORK
exec spinup new plain --api-only --module example.com/plain --no-git --non-interactive
cd plain
! exec spinup g resource Note body:text --mcp --api-only
stderr 'Try: spinup module add mcp'
! exists api/db/queries/notes.sql

-- mcp_test.go --
package mcp

import (
 "errors"
 "testing"

 "github.com/jackc/pgx/v5"
 "github.com/stopyellingatme/spinup/kit/httpx"
)

func TestGeneratedTools(t *testing.T) {
 s, err := New(Deps{Version: "test"})
 if err != nil { t.Fatal(err) }
 if len(s.Tools()) != 11 { t.Fatalf("tools = %d, want 11", len(s.Tools())) }
 for _, tool := range s.Tools() {
  switch tool.Name {
  case "create_task":
   if len(tool.Roles)!=1 || tool.Roles[0]!="manager" { t.Fatalf("roles: %v",tool.Roles) }
  case "list_notes", "get_note":
   if !tool.ReadOnly { t.Fatalf("%s is writable", tool.Name) }
  case "update_note":
   if !tool.Idempotent || tool.ReadOnly { t.Fatalf("update annotations: %+v", tool) }
  case "delete_note":
   if !tool.Destructive || !tool.Idempotent || tool.ReadOnly { t.Fatalf("delete annotations: %+v", tool) }
  }
 }
 for _,status := range []int{404,422} {
  problem := &httpx.Error{Problem:httpx.Problem{Status:status,Detail:"problem detail"}}
  if got:=notesToolError(problem).Error();got!="problem detail Try: check the arguments." { t.Fatalf("problem = %s",got) }
 }
 if got:=notesToolError(pgx.ErrNoRows).Error();got!="The record does not exist. Try: use an existing id." { t.Fatal(got) }
 system:=errors.New("system failure")
 if !errors.Is(notesToolError(system),system) { t.Fatal("system error changed") }
 if notesToolDetail(nil)==nil {t.Fatal("nil detail has no error")}
}
