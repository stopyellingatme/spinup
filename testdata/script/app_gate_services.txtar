# App gate: sidecar services (ADR 0022 §2). A full app with the jobs module gets a Rust and a
# Python service and their Go clients. The API builds. Both service images build, run, and answer
# /healthz and POST /v1/sum, and the healthcheck command of each image passes.
# The image builds need Docker and the network (crates.io, PyPI, and the pinned base images).
[!exec:docker] skip 'docker is required for the service images'
[!exec:curl] skip 'curl is required to call the services'
[!exec:pnpm] skip 'pnpm is required: put scripts/bin on PATH'
[!exec:node] skip 'Node 24 is required on PATH'

env SPINUP_KIT_REPLACE=$SPINUP_REPO/kit
exec spinup new gatesvc --module example.com/gatesvc --modules ci,deploy,jobs --no-git --non-interactive
cd gatesvc
exists api/cmd/worker/main.go
# spinup g client also generates the TypeScript client, so the web packages come first.
exec pnpm --dir web install --frozen-lockfile --offline

exec spinup g service rs --lang rust
exists services/rs/Dockerfile services/rs/Cargo.lock services/rs/openapi.yaml
exec spinup g service py --lang python
exists services/py/Dockerfile services/py/uv.lock services/py/openapi.yaml
grep '^name = "rs"$' spinup.toml
grep '^name = "py"$' spinup.toml
grep '^healthcheck = \["/service", "healthcheck"\]$' spinup.toml
grep '^healthcheck = \["/app/.venv/bin/python", "-m", "service.healthcheck"\]$' spinup.toml

# The Go clients of both services, then the API with the clients and the jobs worker.
exec spinup g client
exists api/internal/services/rs/client.gen.go api/internal/services/rs/rs.go
exists api/internal/services/py/client.gen.go api/internal/services/py/py.go
grep 'SERVICE_RS_URL' api/internal/services/rs/rs.go
grep 'SERVICE_PY_URL' api/internal/services/py/py.go
cd api
exec go build ./...
cd ..

# Build the two images for the platform of the Docker daemon, run them, and call them.
exec bash $WORK/images.sh
stdout '^rs: /healthz ok, POST /v1/sum ok, healthcheck ok$'
stdout '^py: /healthz ok, POST /v1/sum ok, healthcheck ok$'

-- images.sh --
# images.sh builds the rs and py images with spinup build, runs each one, and checks /healthz,
# POST /v1/sum, and the healthcheck command of the image. A trap removes the containers and
# the images, also when a check fails.
set -euo pipefail

app=gatesvc
tag="gate-$$"
containers=()

cleanup() {
  local status=$?
  set +e
  for c in ${containers[@]+"${containers[@]}"}; do
    if [[ $status -ne 0 ]]; then
      echo "--- docker logs $c" >&2
      docker logs "$c" >&2
    fi
    docker rm -f "$c" >/dev/null 2>&1
  done
  docker image rm -f "$app-rs:$tag" "$app-py:$tag" >/dev/null 2>&1
  exit "$status"
}
trap cleanup EXIT

arch="$(docker version --format '{{.Server.Arch}}')"
spinup build --image --target rs,py --tag "$tag" --platform "linux/$arch" >&2

# check <name> <healthcheck command...> runs the image of the service <name> and calls it.
check() {
  local name=$1 c port body
  shift
  c="$app-$name-$$"
  containers+=("$c")
  docker run -d --name "$c" -p 127.0.0.1::8080 "$app-$name:$tag" >/dev/null
  port="$(docker port "$c" 8080/tcp | head -n 1 | sed 's/.*://')"
  body="$(curl -fsS -m 5 --retry 60 --retry-delay 1 --retry-connrefused --retry-all-errors "http://127.0.0.1:$port/healthz")"
  if [[ "$body" != ok ]]; then
    echo "images.sh: $name /healthz answered $body, want ok" >&2
    exit 1
  fi
  body="$(curl -fsS -m 10 -H 'Content-Type: application/json' -d '{"values": [1, 2.5]}' "http://127.0.0.1:$port/v1/sum")"
  if ! grep -Eq '"sum": ?3\.5([,}]|$)' <<<"$body"; then
    echo "images.sh: $name POST /v1/sum answered $body, want {\"sum\": 3.5}" >&2
    exit 1
  fi
  if ! docker exec "$c" "$@" >&2; then
    echo "images.sh: the healthcheck command $* failed in $c" >&2
    exit 1
  fi
  echo "$name: /healthz ok, POST /v1/sum ok, healthcheck ok"
}

check rs /service healthcheck
check py /app/.venv/bin/python -m service.healthcheck
