# Simulate an app whose lock predates the two new auth files.
env SPINUP_KIT_REPLACE=$SPINUP_REPO/kit
mkversion 0.0.1
env SPINUP_TEMPLATES_DIR=$WORK/templates
exec spinup new demo --module example.com/demo --modules ci,auth --non-interactive
cd demo
exec go run ../oldlock.go spinup.lock
rm api/db/kit/00005_users_role.sql api/internal/roles/roles.gen.go
cp ../widgets.sql api/db/migrations/00005_widgets.sql
exec sh -c 'cat ../auth.toml >> spinup.toml'
exec git add -A
exec git commit -q -m 'existing app with custom auth and migration'

# The app 00005 and the kit 00005 live in separate version spaces (ADR 0028), so the preview shows no clash.
exec spinup upgrade --plan --offline
! stdout 'Warning: migration version'
! stdout 'Applied migration'
stdout 'api/db/kit/00005_users_role.sql'
stdout 'Try: run spinup g roles after the upgrade\.'
exists .spinup/plan.json
! exists .spinup/upgrade/0.0.1

-- auth.toml --

[auth]
roles = ["owner", "cook"]
admin_role = "owner"
default_role = "cook"
-- widgets.sql --
-- +goose Up
CREATE TABLE widgets (id bigint);
-- +goose Down
DROP TABLE widgets;
-- oldlock.go --
package main

import (
 "encoding/json"
 "os"
)

func main() {
 path := os.Args[1]
 data, err := os.ReadFile(path)
 if err != nil { panic(err) }
 var lock map[string]any
 if err := json.Unmarshal(data, &lock); err != nil { panic(err) }
 files := lock["files"].(map[string]any)
 delete(files, "api/db/kit/00005_users_role.sql")
 delete(files, "api/internal/roles/roles.gen.go")
 data, err = json.MarshalIndent(lock, "", "  ")
 if err != nil { panic(err) }
 if err := os.WriteFile(path, append(data, '\n'), 0o644); err != nil { panic(err) }
}
