# Keep the database checks conditional. The static checks build the generated API offline.
# Kit migrations and app migrations have separate version spaces (ADR 0028). An app 00004 and a
# kit 00005 do not clash, and the app reset leaves the kit space alone.
env SPINUP_KIT_REPLACE=$SPINUP_REPO/kit
exec spinup new demo --module example.com/demo --modules ci,auth --no-git --non-interactive
cd demo
exists api/db/kit/00005_users_role.sql
! exists api/db/migrations/00005_users_role.sql
cp $SPINUP_REPO/testdata/corpus/roles/old/api/db/migrations/00004_existing_users.sql api/db/migrations/00004_existing_users.sql
cp $SPINUP_REPO/testdata/corpus/roles/check/session_test.go api/upgrade_roles_test.go

# The kit files apply first. The app file 00004 applies after them and finds the users table.
[env:DATABASE_URL] exec spinup db migrate up
[env:DATABASE_URL] stdout 'applied  kit 00005_users_role\.sql'
[env:DATABASE_URL] stdout 'applied  00004_existing_users\.sql'
[env:DATABASE_URL] exec spinup db status
[env:DATABASE_URL] stdout '^applied  kit 00005_users_role\.sql$'
[env:DATABASE_URL] stdout '^applied  00004_existing_users\.sql$'
cd api
exec go test -run '^$' ./...
[env:DATABASE_URL] exec go test -count=1 -run TestUpgradedUsersDefaultRole .
cd ..

# The app reset rolls back the app space only. The kit migrations stay applied.
[env:DATABASE_URL] exec spinup db to 0 --i-know
[env:DATABASE_URL] stdout 'rolled back  00004_existing_users\.sql'
[env:DATABASE_URL] ! stdout 'rolled back  kit'
[env:DATABASE_URL] exec spinup db status
[env:DATABASE_URL] stdout '^applied  kit 00005_users_role\.sql$'
[env:DATABASE_URL] ! stdout '^applied  00004_existing_users\.sql$'

# The next migrate applies the app files again and no kit file.
[env:DATABASE_URL] exec spinup db migrate up
[env:DATABASE_URL] stdout 'applied  00004_existing_users\.sql'
[env:DATABASE_URL] ! stdout 'applied  kit'
[env:DATABASE_URL] exec spinup db migrate up
[env:DATABASE_URL] stdout 'migrate: no pending migrations'
cd api
[env:DATABASE_URL] exec go test -count=1 -run TestUpgradedUsersDefaultRole .

# Roll back both spaces so that the next run starts from an empty database.
[env:DATABASE_URL] exec go run ./cmd/api migrate kit to 0
[env:DATABASE_URL] stdout 'rolled back  kit 00005_users_role\.sql'
