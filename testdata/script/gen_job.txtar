# g job adds River jobs to an app with the jobs module, and the app builds offline.
env SPINUP_KIT_REPLACE=$SPINUP_REPO/kit
exec spinup new todo --api-only --module example.com/todo --modules ci,jobs --no-git --non-interactive
stdout 'from packs base, api, ci, jobs'
cd todo
exists api/cmd/worker/main.go api/internal/jobs/deps.go api/internal/jobs/register.go
grep 'db.WithHook\(jobs.MigrationHook\(\)\)' api/cmd/api/main.go
! exists api/internal/jobs/register_gen.go

# A dry run writes nothing.
exec spinup g job send_digest --dry-run
stdout 'create api/internal/jobs/send_digest.go \(scaffold\)'
stdout 'create api/internal/jobs/register_gen.go \(managed\)'
! exists api/internal/jobs/send_digest.go

exec spinup g job send_digest
stdout 'Created 3, updated 0 files'
stdout 'Next: cd api && go test ./internal/jobs/...'
exists api/internal/jobs/send_digest.go api/internal/jobs/send_digest_test.go
grep 'func \(SendDigestArgs\) Kind\(\) string \{ return "send_digest" \}' api/internal/jobs/send_digest.go
grep '^\tjobs.Register\(w, SendDigest\(d\)\)$' api/internal/jobs/register_gen.go
exec spinup check
! stderr .

# A second job rewrites the generator-owned register_gen.go without --force, sorted.
exec spinup g job cleanupSessions
stdout 'Created 2, updated 1 files'
cmp api/internal/jobs/register_gen.go ../want/register_gen.go

# The same job again changes nothing. After an edit, it needs --force.
exec spinup g job send_digest
stdout 'Created 0, updated 0 files'
cp ../want/edited.go api/internal/jobs/send_digest.go
! exec spinup g job send_digest
stderr 'api/internal/jobs/send_digest.go'
stderr 'Try: pass --force'

# The app builds and vets offline.
cd api
exec go build ./...
exec go vet ./...
cd ..

# With a database: River migrates in the same migrate step, and the job tests pass.
[env:DATABASE_URL] exec spinup db migrate up
[env:DATABASE_URL] stdout 'river'
[env:DATABASE_URL] exec spinup db migrate up
[env:DATABASE_URL] stdout '^river: up to date$'
[env:DATABASE_URL] cd api
[env:DATABASE_URL] exec go run ./cmd/api jobs-migrate status
[env:DATABASE_URL] stdout '^applied  river 001 '
[env:DATABASE_URL] ! stdout '^pending'
[env:DATABASE_URL] exec go test ./...
[env:DATABASE_URL] cd ..

# An app without the jobs module refuses g job.
cd ..
exec spinup new plain --api-only --module example.com/plain --no-git --non-interactive
cd plain
! exec spinup g job send_digest
stderr 'no jobs module'
stderr 'Try: add the jobs module: create the app with --modules ci,jobs'
! exists api/internal/jobs

-- want/edited.go --
package jobs

import (
	"context"

	"github.com/stopyellingatme/spinup/kit/jobs"
)

// SendDigestArgs are the arguments of a send_digest job.
type SendDigestArgs struct {
	UserID int64 `json:"user_id"`
}

// Kind names the job kind in River.
func (SendDigestArgs) Kind() string { return "send_digest" }

// SendDigest returns the function that works send_digest jobs.
func SendDigest(d Deps) func(ctx context.Context, job jobs.Job[SendDigestArgs]) error {
	return func(ctx context.Context, job jobs.Job[SendDigestArgs]) error { return nil }
}
-- want/register_gen.go --
// Code generated by spinup g job. DO NOT EDIT.

package jobs

import "github.com/stopyellingatme/spinup/kit/jobs"

func init() { generated = registerGenerated }

// registerGenerated registers every job of this package, sorted by name.
// spinup g job rewrites this file from the <Name>Args types and <Name>
// functions it finds in the package.
func registerGenerated(w *jobs.Worker, d Deps) {
	jobs.Register(w, CleanupSessions(d))
	jobs.Register(w, SendDigest(d))
}
