# Generate the live module and build the API without a database (ADR 0033 section 11).
env SPINUP_KIT_REPLACE=$SPINUP_REPO/kit
exec spinup new demo --modules auth,live --module example.com/demo --no-git --non-interactive
cd demo
exists api/db/kit/00011_live.sql
exists api/internal/live/live.go
exists api/internal/live/feeds_gen.go
exists web/src/lib/live.core.ts
exists web/src/lib/live.svelte.ts
exists web/src/lib/live.core.test.ts
grep '^modules = .*live' spinup.toml
grep 'func Routes\(h \*kitlive.Hub, d Deps\) func\(\*http.ServeMux\)' api/internal/live/live.go
grep 'registerGenerated\(mux, h, d\)' api/internal/live/live.go
grep '^// Code generated by spinup. DO NOT EDIT\.$' api/internal/live/feeds_gen.go
grep 'func registerGenerated\(mux \*http.ServeMux, h \*kitlive.Hub, d Deps\) \{' api/internal/live/feeds_gen.go

# The main.go wiring includes the limits, routes, drain, and shutdown.
grep 'applive "example.com/demo/api/internal/live"' api/cmd/api/main.go
grep 'kitlive "github.com/stopyellingatme/spinup/kit/x/live"' api/cmd/api/main.go
grep 'env:"LIVE_MAX_STREAMS" default:"2000"' api/cmd/api/main.go
grep 'env:"LIVE_MAX_STREAMS_PER_USER" default:"8"' api/cmd/api/main.go
grep 'liveHub, err := kitlive.New\(pool,' api/cmd/api/main.go
grep 'kitlive.WithMaxStreams\(liveEnv.MaxStreams\)' api/cmd/api/main.go
grep 'kitlive.WithMaxStreamsPerUser\(liveEnv.MaxStreamsPerUser\)' api/cmd/api/main.go
grep 'liveHub.Start\(ctx\)' api/cmd/api/main.go
grep 'app.WithRequestTimeoutExempt\(kitlive.IsStream\),' api/cmd/api/main.go
grep 'app.WithRoutes\(applive.Routes\(liveHub, applive.Deps\{DB: pool\}\)\),' api/cmd/api/main.go
grep 'app.WithCommand\("live", liveHub.Command\(\)\),' api/cmd/api/main.go
grep 'app.WithReadiness\("live", liveHub.Ready\),' api/cmd/api/main.go
grep 'app.WithDrain\(liveHub.Drain\),' api/cmd/api/main.go
grep 'app.WithShutdown\(liveHub.Close\),' api/cmd/api/main.go

# The doctor check finds every wiring line. The app has no feed yet.
exec sh -c 'spinup doctor --quick --json || test "$?" -eq 1'
stdout '(?s)"id": "live-wired",\s+"status": "ok"'

cd api
exec go build ./...
exec go vet ./...
cd $WORK

# An app without live has no live files or wiring.
exec spinup new plain --modules auth --module example.com/plain --no-git --non-interactive
cd plain
! exists api/db/kit/00011_live.sql
! exists api/internal/live/live.go
! exists api/internal/live/feeds_gen.go
! exists web/src/lib/live.core.ts
! exists web/src/lib/live.svelte.ts
! exists web/src/lib/live.core.test.ts
! grep 'applive|kitlive|liveHub|liveEnv|LIVE_MAX_STREAMS' api/cmd/api/main.go
exec sh -c 'spinup doctor --quick || test "$?" -eq 1'
stdout 'skip\tlive-wired\tno live module'
cd $WORK

# Live requires auth and cannot use embed mode.
! exec spinup new noauth --modules live --module example.com/noauth --no-git --non-interactive
stderr 'pack "live" requires missing pack "auth"'
stderr 'Try: select the required module with --modules'
! exists noauth/spinup.toml
! exec spinup new embedded --frontend-mode embed --modules auth,live --module example.com/embedded --no-git --non-interactive
stderr 'cannot use auth in embed mode'
! exists embedded/spinup.toml
