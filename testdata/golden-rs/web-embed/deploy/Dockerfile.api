# Build with the API context and the web context:
# docker build -f deploy/Dockerfile.api --build-context web=web api
FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS web-build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /web
COPY --from=web package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=web . .
# --ignore-scripts skips the prepare script, so run svelte-kit sync before the build.
RUN pnpm exec svelte-kit sync && pnpm build

# A local kit patch uses the build context kit:
# docker build -f deploy/Dockerfile.api --build-context kit=<kit dir> api
FROM scratch AS kit

FROM rust:1.99.1-alpine3.24@sha256:b1d5dd5a22a09404d3e798c0cf051b689077360374eb505fa5bb93c479693d87 AS chef
ENV RUSTUP_TOOLCHAIN=1.99.1
RUN apk add --no-cache musl-dev cmake make perl clang
RUN cargo install cargo-chef --locked --version 0.1.78
WORKDIR /src

FROM chef AS planner
COPY . .
# Cargo reads path patches during recipe discovery. Remap the host path first.
RUN --mount=type=bind,from=kit,target=/kit \
    if [ -f /kit/Cargo.toml ]; then \
      mkdir -p /opt/kit && cp -a /kit/. /opt/kit/ && \
      sed -i 's|spinup-kit = { path = ".*" }|spinup-kit = { path = "/opt/kit" }|' Cargo.toml; \
    fi
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build
COPY --from=planner /src/recipe.json recipe.json
RUN --mount=type=bind,from=kit,target=/kit \
    if [ -f /kit/Cargo.toml ]; then mkdir -p /opt/kit && cp -a /kit/. /opt/kit/; fi
ENV SQLX_OFFLINE=true
RUN cargo chef cook --release --locked --recipe-path recipe.json
COPY . .
RUN if [ -f /opt/kit/Cargo.toml ]; then \
      sed -i 's|spinup-kit = { path = ".*" }|spinup-kit = { path = "/opt/kit" }|' Cargo.toml; \
    fi

# Embed only the assets from this web build.
RUN rm -rf webdist
COPY --from=web-build /web/build ./webdist

ARG VERSION=dev
ARG GIT_SHA=
RUN SPINUP_APP_VERSION="${VERSION}" SPINUP_APP_GIT_SHA="${GIT_SHA}" \
    SPINUP_APP_RUST="$(rustc --version)" cargo build --release --locked --bin api

FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
ENV SPINUP_ENV=production
COPY --from=build /src/target/release/api /api
USER nonroot
EXPOSE 8080
ENTRYPOINT ["/api"]
