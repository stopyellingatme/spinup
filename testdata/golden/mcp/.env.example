# Select the application environment.
SPINUP_ENV=dev
# Set the HTTP port.
PORT=8080
# Set the minimum log severity.
LOG_LEVEL=debug
# Connect to the local development database.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Set the local PostgreSQL password.
POSTGRES_PASSWORD=app
# Set the local PostgreSQL port.
POSTGRES_PORT=5432
