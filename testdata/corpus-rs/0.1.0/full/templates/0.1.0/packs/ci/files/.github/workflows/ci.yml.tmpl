# Managed by spinup. Regenerated on upgrade.
# Add extensions in a separate workflow file.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  api:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    services:
      postgres:
        image: [% if (data.db_version == "18") %][[ image("postgres") ]][% else %][% if (data.db_version == "17") %][[ image("postgres-17") ]][% else %][[ image("postgres-16") ]][% endif %][% endif %]
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: app
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres -d app"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    defaults:
      run:
        shell: bash
        working-directory: api
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/app?sslmode=disable
      SQLX_OFFLINE: "true"
      CI: "true"
    steps:
      - uses: [[ uses("actions/checkout") ]]
        with:
          persist-credentials: false
      - name: Install the Rust toolchain
        run: |
          set -euo pipefail
          toolchain=$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)
          rustup toolchain install "$toolchain" --profile minimal --component rustfmt --component clippy
          rustup default "$toolchain"
      - uses: [[ uses("actions/cache") ]]
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            api/target
          key: ${{ runner.os }}-cargo-${{ hashFiles('api/Cargo.lock', 'api/rust-toolchain.toml') }}
      - name: Check the API
        run: |
          set -euo pipefail
          cargo fmt --check
          cargo clippy --locked --all-targets -- -D warnings
          cargo test --locked
      - name: Check the query cache
        run: |
          set -euo pipefail
          cargo install sqlx-cli --version [[ data.Stack.CargoTools["sqlx-cli"] ]] --locked --no-default-features --features postgres,rustls,sqlx-toml
          cargo run --locked -- migrate up
          SQLX_OFFLINE=false cargo sqlx prepare --check --workspace -- --all-targets
      - name: Check the OpenAPI spec
        run: |
          set -euo pipefail
          cargo run --locked -- openapi > "$RUNNER_TEMP/openapi.yaml"
          diff -u openapi/bundle.gen.yaml "$RUNNER_TEMP/openapi.yaml"[% if get(data, "shadcn_registry") %]

  web:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        shell: bash
        working-directory: web
    steps:
      - uses: [[ uses("actions/checkout") ]]
        with:
          persist-credentials: false
      - uses: [[ uses("actions/setup-node") ]]
        with:
          node-version: '[[ go_printf("%.2s", ((get(data.Stack.Images, "node"))).Tag) ]]'[% if ((get(data, "package_manager")) == "bun") %]
      - run: |
          set -euo pipefail
          npm install --global bun@[[ npm("bun") ]][% else %]
      - uses: [[ uses("pnpm/action-setup") ]]
        with:
          package_json_file: web/package.json[% endif %]
      - run: |
          set -euo pipefail[% if ((get(data, "package_manager")) == "bun") %]
          bun install --frozen-lockfile
          bun run check
          # A new app has no unit tests. Playwright runs in its own workflow.
          bun run test --passWithNoTests[% else %]
          pnpm install --frozen-lockfile
          pnpm check
          # A new app has no unit tests. Playwright runs in its own workflow.
          pnpm test --passWithNoTests[% endif %][% endif %]

  spinup:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: [[ uses("actions/checkout") ]]
        with:
          persist-credentials: false
      - name: Install the Rust toolchain
        run: |
          set -euo pipefail
          toolchain=$(sed -n 's/^channel = "\(.*\)"/\1/p' api/rust-toolchain.toml)
          rustup toolchain install "$toolchain" --profile minimal --component rustfmt --component clippy
          rustup default "$toolchain"[% if get(data, "shadcn_registry") %]
      - uses: [[ uses("actions/setup-node") ]]
        with:
          node-version: '[[ go_printf("%.2s", ((get(data.Stack.Images, "node"))).Tag) ]]'[% if ((get(data, "package_manager")) == "bun") %]
      - run: |
          set -euo pipefail
          npm install --global bun@[[ npm("bun") ]][% else %]
      - uses: [[ uses("pnpm/action-setup") ]]
        with:
          package_json_file: web/package.json[% endif %][% endif %]
      - uses: ./.github/actions/setup-spinup
      - run: |
          set -euo pipefail
          cp .env.example .env
          chmod 0600 .env
          spinup check --allow-behind
          spinup doctor
