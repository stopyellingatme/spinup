name = "[[ data.Name ]]"
version = "0.1.0"
api = 1
spinup = ">=0.0.0"
kind = "[[ data.Kind ]]"
description = "Templates for [[ data.Name ]]."

[% if (data.Kind == "exec") %][exec]
# Build each declared binary before distributing this plugin.
binaries = { "[[ data.Platform ]]" = "bin/[[ data.Name ]]_[[ data.GOOS ]]_[[ data.GOARCH ]]" }

[% endif %][[ "[[" ]]generators]]
name = "[[ data.Name ]]-note"
short = "Create a note"
usage = "[[ data.Name ]]-note <Name>"
args = ["Name"]

[[ "[[" ]]generators.files]]
path = "notes/{{.Name}}.txt"
source = "files/note.txt.tmpl"
class = "scaffold"
