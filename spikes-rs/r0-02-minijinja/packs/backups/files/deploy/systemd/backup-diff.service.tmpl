# Managed by spinup.
[Unit]
Description=Backup diff for [[ data.app_name ]]
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=[[ go_default("deploy", (get(data, "deploy_user"))) ]]
ExecStart=/opt/[[ data.app_name ]]/backups/run.sh diff
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
