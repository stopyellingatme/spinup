name: [[ data.app_name ]]-dev

services:
  postgres:
    image: [% if (data.db_version == "18") %][[ image("postgres") ]][% else %][% if (data.db_version == "17") %][[ image("postgres-17") ]][% else %][[ image("postgres-16") ]][% endif %][% endif %]
    environment:
      POSTGRES_USER: app
      POSTGRES_DB: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-app}
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql[% if (data.db_version != "18") %]/data[% endif %]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 5s
      timeout: 5s
      retries: 10
  mailpit:
    image: [[ image("mailpit") ]]
    ports:
      - "127.0.0.1:8025:8025"
      - "127.0.0.1:1025:1025"

volumes:
  postgres_data:
