#!/usr/bin/env python3
"""Validate installed targets without invoking rustup or downloading components."""
import pathlib
import subprocess
import sys

if sys.argv[1:3] != ["target", "add"] or len(sys.argv) != 4:
    sys.exit("offline guard: only an installed target check is permitted")
target = sys.argv[3]
sysroot = pathlib.Path(subprocess.check_output(["rustc", "--print", "sysroot"], text=True).strip())
installed = sysroot / "lib" / "rustlib" / target / "lib"
if not any(installed.glob("libstd-*")):
    sys.exit(f"offline guard: {target} is not installed. No installation was attempted.")
print(f"offline guard: {target} is already installed")
