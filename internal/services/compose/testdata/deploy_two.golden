# Written by spinup deploy from spinup.toml. Do not edit: spinup writes this file again for each release.
# The color project uses it as a second -f file after compose.yml, which defines the networks.

services:
  ocr:
    image: todo-ocr:r1 # spinup:allow unpinned-image spinup deploy sets the release tag, never latest
    user: "${DEPLOY_UID:-1000}:${DEPLOY_GID:-1000}"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs:
      - /tmp
    environment:
      PORT: "8080"
      OTEL_EXPORTER_OTLP_ENDPOINT: "http://alloy:4318"
      OTEL_SERVICE_NAME: "todo-ocr"
      OTEL_RESOURCE_ATTRIBUTES: "service.instance.id=${SPINUP_COLOR}"
    networks:
      app:
        aliases:
          - ocr-${SPINUP_COLOR}
    deploy:
      replicas: 1
    stop_grace_period: 20s
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
  tts:
    image: todo-tts:r1 # spinup:allow unpinned-image spinup deploy sets the release tag, never latest
    user: "${DEPLOY_UID:-1000}:${DEPLOY_GID:-1000}"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    tmpfs:
      - /tmp
    environment:
      PORT: "9000"
      OTEL_EXPORTER_OTLP_ENDPOINT: "http://alloy:4318"
      OTEL_SERVICE_NAME: "todo-tts"
      OTEL_RESOURCE_ATTRIBUTES: "service.instance.id=${SPINUP_COLOR}"
    networks:
      app:
        aliases:
          - tts-${SPINUP_COLOR}
    deploy:
      replicas: 3
      resources:
        limits:
          memory: 1g
    stop_grace_period: 20s
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
  api:
    environment:
      SERVICE_OCR_URL: "http://ocr-${SPINUP_COLOR}:8080"
      SERVICE_TTS_URL: "http://tts-${SPINUP_COLOR}:9000"
  worker:
    environment:
      SERVICE_OCR_URL: "http://ocr-${SPINUP_COLOR}:8080"
      SERVICE_TTS_URL: "http://tts-${SPINUP_COLOR}:9000"
