# Written by spinup dev from spinup.toml. Do not edit: spinup writes this file again each time it starts.
# The paths are relative to the app root, the Compose project directory of spinup dev.

services:
  ocr:
    build:
      context: services/ocr
      dockerfile: Dockerfile
    ports:
      - "127.0.0.1:8101:8080"
    environment:
      PORT: "8080"
  tts:
    build:
      context: services/tts
      dockerfile: Dockerfile
    ports:
      - "127.0.0.1:8102:9000"
    environment:
      PORT: "9000"
