import type { LayoutServerLoad } from './$types';

[[ if has "billing" .modules -]]
import { error } from '@sveltejs/kit';
import { getBilling } from '#lib/server/billing.js';

// Load the billing summary only for a signed-in user.
export const load: LayoutServerLoad = async ({ fetch, locals }) => {
 const result = locals.user ? await getBilling(fetch) : null;
 if (result && !result.ok) error(result.status, result.errors.form ?? Object.values(result.errors.fields).join(' '));
 return { user: locals.user, billing: result?.ok ? result.data : null[[ if has "flags" .modules ]], flags: locals.flags[[ end ]] };
};
[[- else if has "flags" .modules -]]
// hooks.server.ts sets locals.user and locals.flags. Every page gets them as data.user and data.flags.
export const load: LayoutServerLoad = ({ locals }) => ({ user: locals.user, flags: locals.flags });
[[- else -]]
// hooks.server.ts sets locals.user. Every page gets it as data.user.
export const load: LayoutServerLoad = ({ locals }) => ({ user: locals.user });
[[- end ]]
