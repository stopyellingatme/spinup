# Managed by spinup. Add extensions in a separate workflow file.
name: End-to-end tests

on:
  pull_request:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  e2e:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    services:
      postgres:
        image: [[ if eq .db_version "18" ]][[ image "postgres" ]][[ else if eq .db_version "17" ]][[ image "postgres-17" ]][[ else ]][[ image "postgres-16" ]][[ end ]]
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: app
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres -d app"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/app?sslmode=disable
      PUBLIC_ORIGIN: http://127.0.0.1:3000
      API_URL: http://127.0.0.1:8080
      E2E_BASE_URL: http://127.0.0.1:3000
      SPINUP_ENV: dev
      GOTOOLCHAIN: local
      CI: "true"
    steps:
      - uses: [[ uses "actions/checkout" ]]
        with:
          persist-credentials: false
      - uses: [[ uses "actions/setup-go" ]]
        with:
          go-version-file: api/go.mod
          cache-dependency-path: api/go.sum
      - uses: [[ uses "actions/setup-node" ]]
        with:
          node-version: '[[ printf "%.2s" (index .Stack.Images "node").Tag ]]'
      - uses: [[ uses "pnpm/action-setup" ]]
        with:
          package_json_file: web/package.json
      - name: Install the web dependencies and Chromium
        working-directory: web
        run: |
          set -euo pipefail
          pnpm install --frozen-lockfile
          pnpm exec playwright install --with-deps chromium
      - name: Migrate the database
        working-directory: api
        run: |
          set -euo pipefail
          go run ./cmd/api migrate up
      - name: Build the web app
        working-directory: web
        run: |
          set -euo pipefail
          pnpm build
      - name: Start the API and the web app, then run Playwright
        shell: bash
        run: |
          set -euo pipefail
          (cd api && PORT=8080 go run ./cmd/api) > "$RUNNER_TEMP/api.log" 2>&1 &
          api_pid=$!
          (cd web && PORT=3000 HOST=127.0.0.1 node build) > "$RUNNER_TEMP/web.log" 2>&1 &
          web_pid=$!
          trap 'kill "$api_pid" "$web_pid" 2>/dev/null || true' EXIT
          for url in "$API_URL/healthz" "$PUBLIC_ORIGIN/healthz"; do
            ready=false
            for ((attempt=0; attempt<120; attempt++)); do
              if curl --fail --silent --output /dev/null --max-time 2 "$url"; then
                ready=true
                break
              fi
              sleep 1
            done
            if [ "$ready" != true ]; then
              printf 'Health check failed: %s\n' "$url" >&2
              printf '%s\n' 'Try: reproduce with DATABASE_URL, PUBLIC_ORIGIN, and API_URL from this workflow.' >&2
              exit 1
            fi
          done
          cd web
          pnpm test:e2e
      - uses: [[ uses "actions/upload-artifact" ]]
        if: failure()
        with:
          name: playwright-report
          path: web/playwright-report/
          retention-days: 7
