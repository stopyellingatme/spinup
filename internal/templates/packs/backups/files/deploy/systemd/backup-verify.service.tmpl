# Managed by spinup.
[Unit]
Description=Backup verify for [[ .app_name ]]
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=[[ default "deploy" (index . "deploy_user") ]]
ExecStart=/opt/[[ .app_name ]]/backups/run.sh verify
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
