# Managed by spinup: `spinup upgrade` keeps this file current.
#
# pgBackRest reads this file in the postgres container at /var/lib/pgbackrest/pgbackrest.conf
# (PGBACKREST_CONFIG in compose.backups.yml). `spinup backup now` and the pre-deploy backup
# upload it to /opt/[[ .app_name ]]/backups/pgbackrest.conf on the VM.
#
# The repository location and keys are secrets in secrets/<env>.enc.yaml. The postgres
# container exports each /run/secrets/PGBACKREST_* file as an environment variable:
#   PGBACKREST_REPO1_S3_ENDPOINT    for example s3.eu-central-1.amazonaws.com
#   PGBACKREST_REPO1_S3_BUCKET      the bucket
#   PGBACKREST_REPO1_S3_REGION      for example eu-central-1
#   PGBACKREST_REPO1_S3_KEY         the access key ID
#   PGBACKREST_REPO1_S3_KEY_SECRET  the secret access key
#   PGBACKREST_REPO1_CIPHER_PASS    the repository encryption passphrase (keep a copy offline)
# Optional: PGBACKREST_REPO1_S3_URI_STYLE=path for storage without virtual-host buckets.
#
# Retention: keep this number of full backups, with their differential backups and WAL.
# Set retention = "<n>" in the [backups] table of spinup.toml. spinup writes that value into
# repo1-retention-full when it uploads this file. The default is 4.

[global]
repo1-type=s3
repo1-path=/[[ .app_name ]]
repo1-cipher-type=aes-256-cbc
repo1-retention-full-type=count
repo1-retention-full=4
repo1-bundle=y
repo1-block=y

compress-type=zst
process-max=2
start-fast=y
delta=y

# Push WAL asynchronously through the spool. If the repository is unreachable, drop WAL after
# 4 GiB instead of filling the disk of the database. A dropped segment breaks point-in-time
# recovery until the next backup.
archive-async=y
archive-push-queue-max=4GiB
spool-path=/var/lib/pgbackrest/spool

# The container file system is read-only. Log to the console only (docker logs).
log-level-console=info
log-level-file=off
lock-path=/tmp/pgbackrest

[[ printf "[%s]" .app_name ]]
pg1-path=[[ if eq .db_version "18" ]]/var/lib/postgresql/18/docker[[ else ]]/var/lib/postgresql/data/pgdata[[ end ]]
pg1-socket-path=/var/run/postgresql
pg1-user=app
pg1-database=app
