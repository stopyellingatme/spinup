# Managed by spinup. Regenerated on upgrade.
# Add extensions in a separate workflow file.
name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  api:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    services:
      postgres:
        image: [[ if eq .db_version "18" ]][[ image "postgres" ]][[ else if eq .db_version "17" ]][[ image "postgres-17" ]][[ else ]][[ image "postgres-16" ]][[ end ]]
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: app
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres -d app"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    defaults:
      run:
        working-directory: api
    env:
      DATABASE_URL: postgres://postgres:postgres@localhost:5432/app?sslmode=disable
      GOTOOLCHAIN: local
      CI: "true"
    steps:
      - uses: [[ uses "actions/checkout" ]]
        with:
          persist-credentials: false
      - uses: [[ uses "actions/setup-go" ]]
        with:
          go-version-file: api/go.mod
          cache-dependency-path: api/go.sum
      - run: |
          set -euo pipefail
          go mod verify
          go build ./...
          go vet ./...
          go test -race ./...
[[- if index . "shadcn_registry" ]]

  web:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        shell: bash
        working-directory: web
    steps:
      - uses: [[ uses "actions/checkout" ]]
        with:
          persist-credentials: false
[[- if eq (index . "package_manager") "bun" ]]
      - uses: [[ uses "actions/setup-node" ]]
        with:
          node-version: '[[ printf "%.2s" (index .Stack.Images "node").Tag ]]'
      - run: |
          set -euo pipefail
          npm install --global bun@[[ npm "bun" ]]
[[- else ]]
      - uses: [[ uses "pnpm/action-setup" ]]
        with:
          package_json_file: web/package.json
      - uses: [[ uses "actions/setup-node" ]]
        with:
          node-version: '[[ printf "%.2s" (index .Stack.Images "node").Tag ]]'
          cache: pnpm
          cache-dependency-path: web/pnpm-lock.yaml
[[- end ]]
      - run: |
          set -euo pipefail
[[- if eq (index . "package_manager") "bun" ]]
          bun install --frozen-lockfile
          bun run check
          # A new app has no unit tests. Playwright runs in its own workflow.
          bun run test --passWithNoTests
[[- else ]]
          pnpm install --frozen-lockfile
          pnpm check
          # A new app has no unit tests. Playwright runs in its own workflow.
          pnpm test --passWithNoTests
[[- end ]]
[[- end ]]

  spinup:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    outputs:
      matrix: ${{ steps.services.outputs.matrix }}
      any: ${{ steps.services.outputs.any }}
    steps:
      - uses: [[ uses "actions/checkout" ]]
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: [[ uses "actions/setup-go" ]]
        with:
          go-version-file: api/go.mod
          cache-dependency-path: api/go.sum
[[- if index . "shadcn_registry" ]]
      - uses: [[ uses "actions/setup-node" ]]
        with:
          node-version: '[[ printf "%.2s" (index .Stack.Images "node").Tag ]]'
[[- if eq (index . "package_manager") "bun" ]]
      - run: |
          set -euo pipefail
          npm install --global bun@[[ npm "bun" ]]
[[- else ]]
      - uses: [[ uses "pnpm/action-setup" ]]
        with:
          package_json_file: web/package.json
[[- end ]]
[[- end ]]
      - uses: ./.github/actions/setup-spinup
      - id: services
        env:
          EVENT_NAME: ${{ github.event_name }}
          BASE_REF: ${{ github.base_ref }}
        run: |
          set -euo pipefail
          # A pull request builds only the services that it changed.
          # A push to main and a manual run build every service.
          if [ "$EVENT_NAME" = pull_request ]; then
            matrix="$(spinup ci services --json --changed-since "origin/$BASE_REF")"
          else
            matrix="$(spinup ci services --json)"
          fi
          printf 'matrix=%s\n' "$matrix" >> "$GITHUB_OUTPUT"
          printf 'any=%s\n' "$(jq -r '(.include | length) > 0' <<<"$matrix")" >> "$GITHUB_OUTPUT"
      - run: |
          set -euo pipefail
          cp .env.example .env
          chmod 0600 .env
          spinup check --allow-behind
          spinup doctor

  services:
    needs: spinup
    if: needs.spinup.outputs.any == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.spinup.outputs.matrix) }}
    steps:
      - uses: [[ uses "actions/checkout" ]]
        with:
          persist-credentials: false
      - uses: ./.github/actions/setup-spinup
      - env:
          SERVICE: ${{ matrix.name }}
        run: |
          set -euo pipefail
          spinup build --image --target "$SERVICE"
          spinup ci test-service "$SERVICE"
