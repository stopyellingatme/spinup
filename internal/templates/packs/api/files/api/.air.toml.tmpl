root = "."
tmp_dir = "tmp"

[build]
# -ldflags=-w drops the DWARF debug data. The link is about a third faster. Delve needs the
# debug data: remove -ldflags=-w here, or build by hand (docs/commands/dev.md).
cmd = "go build -ldflags=-w -o ./tmp/api ./cmd/api"
entrypoint = ["./tmp/api"]
# The delay batches the writes of one generator run (sqlc, oapi-codegen) into one build.
delay = 100
include_ext = ["go", "sql"]
include_dir = []
# db/queries holds sqlc inputs only: spinup dev runs sqlc, and the new code in internal/store
# starts the build. internal/store stays watched, or a query edit never reaches a build.
# exclude_unchanged stops a rebuild when sqlc writes the same bytes. db/migrations stays
# watched, because the binary embeds the migrations.
exclude_dir = ["tmp", "node_modules", "internal/gen", "db/queries"]
exclude_regex = ["_test.go"]
exclude_unchanged = true
stop_on_error = true
send_interrupt = true
kill_delay = "4s"

[log]
time = false
main_only = true

[misc]
clean_on_exit = true
