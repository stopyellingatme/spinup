package main

import (
 "context"
 "errors"
 "fmt"
[[- if has "billing" .modules ]]
 "log/slog"
[[- end ]]
 "net/http"
 "os"
 "os/signal"
 "syscall"
[[- if or (has "flags" .modules) (has "apikeys" .modules) ]]
 "time"[[ "\n" ]]
[[- end ]]
[[- if has "flags" .modules ]]
 appflags "[[ .module ]]/api/internal/flags"
 "github.com/stopyellingatme/spinup/kit/x/flags"
[[- end ]]
[[- if has "apikeys" .modules ]]
 appapikeys "[[ .module ]]/api/internal/apikeys"
 "github.com/stopyellingatme/spinup/kit/x/apikeys"
[[- end ]]
[[- if has "mcp" .modules ]]
 appmcp "[[ .module ]]/api/internal/mcp"
 kitmcp "github.com/stopyellingatme/spinup/kit/x/mcp"
[[- end ]]

[[- if has "billing" .modules ]]
 appbilling "[[ .module ]]/api/internal/billing"
 kitbilling "github.com/stopyellingatme/spinup/kit/x/billing"
 "github.com/stopyellingatme/spinup/kit/x/billing/stripe"
[[- end ]]

[[ if has "auth" .modules ]] kitmigrations "[[ .module ]]/api/db/kit"
[[ end ]] "[[ .module ]]/api/db/migrations"
 "[[ .module ]]/api/internal/routes"
 "[[ .module ]]/api/openapi"
[[- if eq (index . "frontend_mode") "embed" ]]
 "[[ .module ]]/api/internal/webdist"
[[- end ]]
[[- if has "mail" .modules ]]
 mailapp "[[ .module ]]/api/internal/mail"
[[- end ]]
 "github.com/stopyellingatme/spinup/kit/app"
[[- if has "audit" .modules ]]
 "github.com/stopyellingatme/spinup/kit/audit"
 "github.com/stopyellingatme/spinup/kit/audit/authsink"
[[- end ]]
[[- if has "auth" .modules ]]
 "[[ .module ]]/api/internal/roles"
 "github.com/stopyellingatme/spinup/kit/auth"
[[- end ]]
 "github.com/stopyellingatme/spinup/kit/config"
 "github.com/stopyellingatme/spinup/kit/db"
 "github.com/stopyellingatme/spinup/kit/telemetry"
[[- if has "jobs" .modules ]]
 "github.com/stopyellingatme/spinup/kit/jobs"
[[- end ]]
)

var version = "dev"

func main() {
 if err := run(); err != nil {
  fmt.Fprintln(os.Stderr, err)
  os.Exit(1)
 }
}

func run() (err error) {
 var cfg config.Base
 if err := config.Load(&cfg); err != nil {
  return err
 }
 ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
 defer stop()
 shutdown, err := telemetry.Setup(ctx, telemetry.Options{ServiceName: [[ quote (printf "%s-api" .app_name) ]], ServiceVersion: version, Environment: cfg.Env})
 if err != nil { return err }
 defer func() {
  shutdownCtx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
  defer cancel()
  err = errors.Join(err, shutdown(shutdownCtx))
 }()
 pool, err := db.Open(ctx, cfg.DatabaseURL, db.WithMaxConns(cfg.DatabaseMaxConns))
 if err != nil {
  return err
 }
[[- if has "mail" .modules ]]
 mailers, err := mailapp.New(pool)
 if err != nil { return err }
 _ = mailers // Pass this dependency to application handlers that send mail.
[[- end ]]
[[- if has "auth" .modules ]]
 // The web app posts its form actions from PUBLIC_ORIGIN, so the CSRF check trusts it.
 var web struct {
  PublicOrigin string `env:"PUBLIC_ORIGIN" default:"http://localhost:5173"`
 }
 if err := config.Load(&web); err != nil {
  return err
 }
[[- if has "apikeys" .modules ]]
 var apikeysEnv struct {
  Flush time.Duration `env:"APIKEYS_FLUSH" default:"5s"`
 }
 if err := config.Load(&apikeysEnv); err != nil {
  return err
 }
 keyStore, err := apikeys.NewStore(pool, appapikeys.Config[[ if has "billing" .modules ]], apikeys.WithSessionOnly(kitbilling.SessionPrefix)[[ end ]][[ if has "mcp" .modules ]], apikeys.WithRPCPath(kitmcp.Path)[[ end ]])
 if err != nil {
  return err
 }
 if err := keyStore.Start(ctx, apikeysEnv.Flush); err != nil {
  return err
 }
[[- if has "mcp" .modules ]]
 mcpServer, err := appmcp.New(appmcp.Deps{DB: pool, Version: version})
 if err != nil {
  return err
 }
[[- end ]]
[[- end ]]
 authn, err := auth.New(pool,
  auth.WithRoles(roles.Set),
[[- if has "apikeys" .modules ]]
  auth.WithBearer(keyStore),
[[- end ]]
[[- if has "audit" .modules ]]
  auth.WithEvents(authsink.New(pool)),
  auth.WithActorContext(authsink.ActorContext),
[[- end ]]
  auth.WithRegistration(auth.RegistrationMode(os.Getenv("AUTH_REGISTRATION"))),
  auth.WithSecureCookie(cfg.Env != "dev"),
  auth.WithTrustedOrigins(web.PublicOrigin),
 )
 if err != nil {
  return err
 }
[[- if has "mail" .modules ]]
 resetRoutes, err := passwordResetRoutes(authn, mailers, web.PublicOrigin)
 if err != nil { return err }
[[- end ]]
[[- end ]]
[[- if has "flags" .modules ]]
 var flagsEnv struct {
  Refresh time.Duration `env:"FLAGS_REFRESH" default:"10s"`
 }
 if err := config.Load(&flagsEnv); err != nil {
  return err
 }
 flagsProvider, err := flags.New(flags.WithDeclared(appflags.Set))
 if err != nil {
  return err
 }
 flagStore := flags.NewStore(pool, flagsProvider, roles.Set)
 if err := flagStore.Start(ctx, flagsEnv.Refresh); err != nil {
  return err
 }
[[- end ]]
[[- if has "billing" .modules ]]
 var billingEnv struct {
  SecretKey string `env:"STRIPE_SECRET_KEY" required:"true"`
  WebhookSecret string `env:"STRIPE_WEBHOOK_SECRET" required:"true"`
  APIBase string `env:"STRIPE_API_BASE"`
 }
 if err := config.Load(&billingEnv); err != nil { return err }
 var stripeOptions []stripe.Option
 if billingEnv.APIBase != "" { stripeOptions = append(stripeOptions, stripe.WithBaseURL(billingEnv.APIBase)) }
 stripeClient, err := stripe.New(billingEnv.SecretKey, stripeOptions...)
 if err != nil { return err }
 jobsClient, err := jobs.New(pool)
 if err != nil { return err }
 billingSvc, err := kitbilling.New(pool, appbilling.Config, stripeClient,
  kitbilling.WithJobs(jobsClient),
  kitbilling.WithRoles(roles.Set),
  kitbilling.WithPublicOrigin(web.PublicOrigin),
  kitbilling.WithWebhookSecrets(billingEnv.WebhookSecret),
  kitbilling.WithLogger(slog.Default()),
[[- if has "apikeys" .modules ]]
  kitbilling.WithAPIKeys(keyStore),
[[- end ]]
 )
 if err != nil { return err }
[[- end ]]
 a := app.New(
  app.WithName([[ quote .app_name ]]),
  app.WithVersion(version),
  app.WithConfig(cfg),
  app.WithAPIDocs(openapi.FS),
[[- if eq (index . "frontend_mode") "embed" ]]
  app.WithSPA(webdist.FS),
[[- end ]]
  app.WithRoutes(func(mux *http.ServeMux) { routes.Register(mux, routes.Deps{DB: pool}) }),
[[- if has "auth" .modules ]]
  app.WithMiddleware(authn.Middleware()),
[[- if has "flags" .modules ]]
  app.WithMiddleware(flagsProvider.Middleware()),
[[- end ]]
[[- if has "apikeys" .modules ]]
  app.WithMiddleware(keyStore.Middleware()),
[[- end ]]
  app.WithRoutes(authn.Routes),
  app.WithCommand("user", auth.UserCommand(authn)),
[[- if has "mail" .modules ]]
  app.WithRoutes(resetRoutes),
[[- end ]]
[[- end ]]
[[- if has "flags" .modules ]]
  app.WithRoutes(flagStore.Routes(authn)),
  app.WithCommand("flags", flagStore.Command()),
  app.WithReadiness("flags", flagStore.Ready),
[[- end ]]
[[- if has "apikeys" .modules ]]
  app.WithRoutes(keyStore.Routes(authn)),
  app.WithCommand("apikeys", keyStore.Command()),
  app.WithReadiness("apikeys", keyStore.Ready),
[[- end ]]
[[- if has "billing" .modules ]]
  app.WithRoutes(billingSvc.Routes(authn)),
  app.WithCommand("billing", billingSvc.Command()),
[[- end ]]
[[- if has "mcp" .modules ]]
  app.WithRoutes(mcpServer.Routes(web.PublicOrigin)),
  app.WithCommand("mcp", mcpServer.Command()),
[[- end ]]
[[- if has "mail" .modules ]]
[[- if has "jobs" .modules ]]
  app.WithCommand("mail-worker", mailers.WorkerCommand(pool)),
[[- end ]]
[[- end ]]
[[- if has "audit" .modules ]]
  app.WithCommand("audit", audit.Command(pool)),
[[- end ]]
  app.WithReadiness("db", pool.Ping),
  app.WithCommand("migrate", db.MigrateCommand(migrations.FS, db.WithDatabaseURL(cfg.DatabaseURL)[[ if has "auth" .modules ]], db.WithKitMigrations(kitmigrations.FS)[[ end ]][[ if has "jobs" .modules ]], db.WithHook(jobs.MigrationHook())[[ end ]])),
[[- if has "jobs" .modules ]]
  app.WithCommand("jobs-migrate", jobs.MigrateCommand(jobs.WithMigrateDatabaseURL(cfg.DatabaseURL))),
[[- end ]]
  app.WithShutdown(func(context.Context) error { pool.Close(); return nil }),
[[- if has "auth" .modules ]]
  app.WithShutdown(authn.Close),
[[- if has "flags" .modules ]]
  app.WithShutdown(flagStore.Close),
[[- end ]]
[[- if has "apikeys" .modules ]]
  app.WithShutdown(keyStore.Close),
[[- end ]]
[[- end ]]
 )
 return a.Run(ctx, os.Args[1:])
}
