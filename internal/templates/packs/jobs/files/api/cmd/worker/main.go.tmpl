// Command worker runs the background jobs of the app.
package main

import (
	"context"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"github.com/jackc/pgx/v5/pgxpool"

	jobsapp "[[ .module ]]/api/internal/jobs"
[[- if has "mail" .modules ]]
	mailapp "[[ .module ]]/api/internal/mail"
[[- end ]]
	"github.com/stopyellingatme/spinup/kit/config"
	"github.com/stopyellingatme/spinup/kit/db"
	"github.com/stopyellingatme/spinup/kit/jobs"
	"github.com/stopyellingatme/spinup/kit/logx"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	var cfg config.Base
	if err := config.Load(&cfg); err != nil {
		return err
	}
	level := slog.LevelInfo
	if err := level.UnmarshalText([]byte(cfg.LogLevel)); err != nil {
		level = slog.LevelInfo
	}
	logger := logx.New(os.Stderr, logx.Options{Level: level})

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	pool, err := db.Open(ctx, cfg.DatabaseURL, db.WithAppName([[ quote .app_name ]]+"-worker"))
	if err != nil {
		return err
	}
	defer pool.Close()

	w, err := newWorker(pool, logger)
	if err != nil {
		return err
	}
	if err := w.Start(ctx); err != nil {
		return err
	}

	<-ctx.Done()
	logger.Info("worker: stopping", "timeout", cfg.ShutdownTimeout.String())
	stopCtx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
	defer cancel()
	return w.Stop(stopCtx)
}

func newWorker(pool *pgxpool.Pool, logger *slog.Logger) (*jobs.Worker, error) {
	w, err := jobs.NewWorker(pool, jobs.WithLogger(logger)[[ if has "mail" .modules ]],
		jobs.WithQueue(jobs.DefaultQueue, jobs.DefaultQueueWorkers),
		jobs.WithQueue("mail", 10),
	[[ end ]])
	if err != nil {
		return nil, err
	}
	jobsapp.Register(w, jobsapp.Deps{DB: pool})
[[- if has "mail" .modules ]]
	mailers, err := mailapp.New(pool)
	if err != nil {
		return nil, err
	}
	mailers.Register(w)
[[- end ]]
	return w, nil
}
