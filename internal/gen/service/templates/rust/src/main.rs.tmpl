mod telemetry;

use axum::{middleware, routing::{get, post}, Json, Router};
use serde::{Deserialize, Serialize};
use std::{env, io::{Read, Write}, net::{SocketAddr, TcpStream}, process, time::Duration};
use tokio::signal;

#[derive(Deserialize)]
struct SumRequest {
    values: Vec<f64>,
}

#[derive(Serialize)]
struct SumResponse {
    sum: f64,
}

fn routes() -> Router {
    Router::new()
        .route("/v1/sum", post(sum))
        .route_layer(middleware::from_fn(telemetry::trace_request))
        .route("/healthz", get(|| async { "ok" }))
}

async fn sum(Json(request): Json<SumRequest>) -> Json<SumResponse> {
    Json(SumResponse { sum: request.values.iter().sum() })
}

fn port() -> u16 {
    env::var("PORT")
        .unwrap_or_else(|_| "{{ .Port }}".to_owned())
        .parse()
        .expect("PORT must be a port from 1 to 65535")
}

fn healthcheck(port: u16) -> std::io::Result<bool> {
    let address = SocketAddr::from(([127, 0, 0, 1], port));
    let timeout = Duration::from_secs(3);
    let mut stream = TcpStream::connect_timeout(&address, timeout)?;
    stream.set_read_timeout(Some(timeout))?;
    stream.set_write_timeout(Some(timeout))?;
    stream.write_all(b"GET /healthz HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")?;
    let mut response = [0; 12];
    stream.read_exact(&mut response)?;
    Ok(&response == b"HTTP/1.1 200" || &response == b"HTTP/1.0 200")
}

#[tokio::main]
async fn main() {
    let port = port();
    if env::args().nth(1).as_deref() == Some("healthcheck") {
        process::exit(if healthcheck(port).unwrap_or(false) { 0 } else { 1 });
    }
    let provider = telemetry::init();
    let listener = tokio::net::TcpListener::bind(("0.0.0.0", port))
        .await
        .expect("cannot bind service port");
    tracing::info!(service = "{{ .Name }}", app = "{{ .App }}", port, "service started");
    let result = axum::serve(listener, routes())
        .with_graceful_shutdown(shutdown())
        .await;
    if let Some(provider) = provider {
        provider.shutdown().expect("cannot flush service traces\nTry: check the OTLP collector and its endpoint");
    }
    result.expect("service failed");
}

async fn shutdown() {
    let ctrl_c = async { signal::ctrl_c().await.expect("cannot listen for Ctrl-C"); };
    #[cfg(unix)]
    let terminate = async {
        signal::unix::signal(signal::unix::SignalKind::terminate())
            .expect("cannot listen for SIGTERM")
            .recv()
            .await;
    };
    #[cfg(not(unix))]
    let terminate = std::future::pending::<()>();
    tokio::select! {
        _ = ctrl_c => {},
        _ = terminate => {},
    }
    tracing::info!("service stopping");
}

#[cfg(test)]
mod tests {
    use super::*;
    use axum::{body::Body, http::{Request, StatusCode}};
    use http_body_util::BodyExt;
    use tower::ServiceExt;

    #[tokio::test]
    async fn health_route() {
        let response = routes().oneshot(Request::builder().uri("/healthz").body(Body::empty()).unwrap()).await.unwrap();
        assert_eq!(response.status(), StatusCode::OK);
        let body = response.into_body().collect().await.unwrap().to_bytes();
        assert_eq!(body.as_ref(), b"ok");
    }

    #[tokio::test]
    async fn sum_route() {
        let response = routes().oneshot(Request::builder()
            .method("POST").uri("/v1/sum").header("content-type", "application/json")
            .body(Body::from(r#"{"values":[1,2.5,-0.5]}"#)).unwrap()).await.unwrap();
        assert_eq!(response.status(), StatusCode::OK);
        let body = response.into_body().collect().await.unwrap().to_bytes();
        let result: serde_json::Value = serde_json::from_slice(&body).unwrap();
        assert_eq!(result["sum"], 3.0);
    }
}
